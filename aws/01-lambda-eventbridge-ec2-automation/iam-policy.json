{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeInstancesForStateCheck",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "StopOnlyTheConfiguredInstance",
      "Effect": "Allow",
      "Action": "ec2:StopInstances",
      "Resource": "arn:aws:ec2:us-east-1:123456789012:instance/i-REPLACE_WITH_INSTANCE_ID"
    }
  ]
}
